{
  "name": "rocobroker",
  "version": "0.1.0",
  "private": true,
  "description": "RocoBroker — multilingual marketing site and native educational blog built with Next.js and next-intl.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "admin:allowlist": "tsx scripts/allowlist-admin.ts",
    "admin:disable": "tsx scripts/disable-admin.ts",
    "content:import": "node --conditions=react-server --import tsx scripts/import-blog-content.ts",
    "content:parity": "node --conditions=react-server --import tsx scripts/verify-content-parity.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@gsap/react": "^2.1.2",
    "@smithy/node-http-handler": "^4.12.1",
    "@swc/helpers": "^0.5.23",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "16.3.5",
    "next-intl": "^4.3.4",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.7",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.24"
  }
}
