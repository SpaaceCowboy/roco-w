{
  "name": "roco-chatwoot-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A guarded AI support AgentBot for ROCO's self-hosted Chatwoot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env --watch --import=tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
