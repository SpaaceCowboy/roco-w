# POST /api/contact hands mail to the MTA on this host (Exim under cPanel),
# which delivers to a local mailbox. No third-party sender and no API key.
# Both default to the loopback MTA; set them only to point elsewhere.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25

# Envelope sender. Must be a real address on a domain this host is allowed to
# send as, or Exim will reject the message.
CONTACT_EMAIL_FROM="ROCO Website <website@rocobroker.com>"

# Optional; defaults to the canonical support address in src/config/contact.ts.
CONTACT_EMAIL_TO=support@rocobroker.com

# Live chat provider. Only the selected provider is loaded.
NEXT_PUBLIC_LIVE_CHAT_PROVIDER=chatwoot

# tawk.to embed URL: https://embed.tawk.to/<property>/<widget>
# These public IDs are required at build time when Tawk is active.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Optional per-locale widget overrides. Unset locales use the default above.
# NEXT_PUBLIC_TAWK_WIDGET_ID_EN=
# NEXT_PUBLIC_TAWK_WIDGET_ID_DE=
# NEXT_PUBLIC_TAWK_WIDGET_ID_RU=
# NEXT_PUBLIC_TAWK_WIDGET_ID_AR=
# NEXT_PUBLIC_TAWK_WIDGET_ID_FA=
# NEXT_PUBLIC_TAWK_WIDGET_ID_ZH=

# Chatwoot website inbox configuration.
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://support.rocobroker.com
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# Crisp test integration. Copy the Website ID from Crisp → Settings → Workspace
# Settings → Setup & Integrations. It is a public widget identifier, not an API
# secret. Set NEXT_PUBLIC_LIVE_CHAT_PROVIDER=crisp to enable it.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Admin content database. Required only by database migration commands and the
# admin/content repository; the current file-backed public blog does not read it.
DATABASE_URL=postgresql://rocobroker:change-me@127.0.0.1:5432/rocobroker

# Public reads stay on the checked-in snapshot until import and parity checks
# pass in production. Roll back instantly by setting this back to "file".
CONTENT_SOURCE=file

# Keep this conservative on the shared production host. Each Next.js process
# creates its own pool.
DATABASE_POOL_MAX=10

# Google OIDC for the internal admin panel. Create a Web application credential
# in Google Cloud and register this exact callback URL:
#   https://rocobroker.com/api/auth/callback/google
# ADMIN_AUTH_BASE_URL=https://rocobroker.com
# ADMIN_AUTH_SECRET=generate-at-least-32-random-bytes
# ADMIN_GOOGLE_CLIENT_ID=
# ADMIN_GOOGLE_CLIENT_SECRET=

# Optional defense in depth. Set to the managed Google Workspace domain to
# reject consumer Google accounts before the database allowlist is checked.
# ADMIN_GOOGLE_HOSTED_DOMAIN=rocobroker.com

# S3-compatible object storage for article images. Cloudflare R2 uses region
# "auto" and endpoint https://<account-id>.r2.cloudflarestorage.com. Keep the
# access key server-only and restrict it to this bucket.
# CONTENT_MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CONTENT_MEDIA_S3_REGION=auto
# CONTENT_MEDIA_S3_ACCESS_KEY_ID=
# CONTENT_MEDIA_S3_SECRET_ACCESS_KEY=
# CONTENT_MEDIA_S3_BUCKET=rocobroker-content
# CONTENT_MEDIA_PUBLIC_BASE_URL=https://media.rocobroker.com

# Optional separate HMAC key for 15-minute draft preview links. When omitted,
# ADMIN_AUTH_SECRET is used with a separate domain prefix.
# ADMIN_PREVIEW_SECRET=generate-at-least-32-random-bytes

# Bearer secret for the bounded scheduled-publication endpoint. Configure the
# host scheduler to POST to /api/admin/scheduled-publications once per minute.
# SCHEDULED_PUBLISH_SECRET=generate-at-least-32-random-bytes

# Optional comma-separated additional hosts reviewers may use for canonical
# overrides. The NEXT_PUBLIC_SITE_URL host is always allowed.
# ADMIN_ALLOWED_CANONICAL_HOSTS=www.rocobroker.com

# Operational alerting. Each consecutive-failure stream (auth, rate limit,
# media upload, publication, cache refresh, scheduled delay) emits an
# `admin.alert` record once this many failures occur back to back. Set a
# positive integer; the default is 5.
# ADMIN_ALERT_FAILURE_THRESHOLD=5

# A due scheduled article older than this many milliseconds is reported as a
# scheduler delay. The host scheduler should POST once per minute.
# ADMIN_SCHEDULED_DELAY_GRACE_MS=300000
