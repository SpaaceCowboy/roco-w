# POST /api/contact hands mail to the MTA on this host (Exim under cPanel),
# which delivers to a local mailbox. No third-party sender and no API key.
# Both default to the loopback MTA; set them only to point elsewhere.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25

# Envelope sender. Must be a real address on a domain this host is allowed to
# send as, or Exim will reject the message.
CONTACT_EMAIL_FROM="ROCO Website <website@rocobroker.com>"

# Optional; defaults to the canonical support address in src/config/contact.ts.
CONTACT_EMAIL_TO=support@rocobroker.com

# Live chat provider. Only the selected provider is loaded.
NEXT_PUBLIC_LIVE_CHAT_PROVIDER=chatwoot

# tawk.to embed URL: https://embed.tawk.to/<property>/<widget>
# These public IDs are required at build time when Tawk is active.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Optional per-locale widget overrides. Unset locales use the default above.
# NEXT_PUBLIC_TAWK_WIDGET_ID_EN=
# NEXT_PUBLIC_TAWK_WIDGET_ID_DE=
# NEXT_PUBLIC_TAWK_WIDGET_ID_RU=
# NEXT_PUBLIC_TAWK_WIDGET_ID_AR=
# NEXT_PUBLIC_TAWK_WIDGET_ID_FA=
# NEXT_PUBLIC_TAWK_WIDGET_ID_ZH=

# Chatwoot website inbox configuration.
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://support.rocobroker.com
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# Crisp test integration. Copy the Website ID from Crisp → Settings → Workspace
# Settings → Setup & Integrations. It is a public widget identifier, not an API
# secret. Set NEXT_PUBLIC_LIVE_CHAT_PROVIDER=crisp to enable it.
NEXT_PUBLIC_CRISP_WEBSITE_ID=
