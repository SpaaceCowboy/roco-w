# App
PORT=3000
HOST=127.0.0.1
# Public URL users will receive
PUBLIC_BASE_URL=https://support-downloads.rocobroker.com
# Long random admin token used to open the dashboard
ADMIN_TOKEN=replace-with-a-long-random-secret

# Temporary direct-upload URL lifetime (15 minutes)
UPLOAD_URL_SECONDS=900

# ParsPack / S3-compatible object storage
# Copy the endpoint and region from your ParsPack Object Storage panel/documentation.
S3_ENDPOINT=https://YOUR-PARSPACK-S3-ENDPOINT
S3_REGION=us-east-1
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Many S3-compatible providers use path-style addressing. If your ParsPack endpoint
# expects virtual-hosted bucket names, set this to false.
S3_FORCE_PATH_STYLE=true

# Metadata database file
DATA_FILE=./data/uploads.json
