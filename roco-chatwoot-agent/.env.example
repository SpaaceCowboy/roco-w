# HTTP service. Bind privately when Apache or another reverse proxy is in front.
HOST=127.0.0.1
PORT=3200

# Chatwoot AgentBot configuration.
CHATWOOT_BASE_URL=https://support.rocobroker.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_AGENT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# OpenAI Responses API, or an OpenAI-compatible /v1 endpoint that implements it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Guardrails and capacity.
BOT_CONFIDENCE_THRESHOLD=0.72
BOT_MAX_CONTEXT_MESSAGES=10
AI_MAX_CONCURRENT=2
AI_QUEUE_LIMIT=100
WEBHOOK_MAX_AGE_SECONDS=300
